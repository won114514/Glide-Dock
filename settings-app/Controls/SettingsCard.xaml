<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlideDock.Settings.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        MinWidth="860"
        Margin="0,0,0,6"
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <SymbolIcon
                        Symbol="{x:Bind IconSymbol, Mode=OneWay}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Text="{x:Bind Title, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Description, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <ContentPresenter
                        VerticalAlignment="Center"
                        Content="{x:Bind CardContent, Mode=OneWay}" />
                    <Button
                        x:Name="ExpandButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ExpandButton_Click"
                        ToolTipService.ToolTip="展开选项"
                        AutomationProperties.Name="展开选项"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="ExpandIcon"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                    </Button>
                </StackPanel>
            </Grid>

            <ContentPresenter
                x:Name="ExpansionHost"
                Margin="50,12,0,0"
                Content="{x:Bind ExpanderContent, Mode=OneWay}"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
