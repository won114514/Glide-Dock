<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GlideDock.Settings.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:GlideDock.Settings.Controls" xmlns:local="using:GlideDock.Settings" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="Glide-Dock 设置">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.Resources>
      <local:ValueLabelConverter x:Key="ValueLabelConverter" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Title bar: the transparent border is the drag region; interactive controls sit above it. -->
    <Grid x:Name="TitleBarHost" Grid.Row="0">
      <Border x:Name="TitleBarDragRegion" Background="Transparent" />
      <Grid Padding="16,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="TitleDragArea" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Width="26" Height="26" Background="Transparent" CornerRadius="7">
            <Image Source="ms-appx:///Assets/Glide-Dock-FullColor-128.png" Stretch="Uniform" />
          </Border>
          <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Glide-Dock" />
        </StackPanel>
        <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" PlaceholderText="搜索设置" QueryIcon="Find" TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
        <Grid Grid.Column="2" />
      </Grid>
    </Grid>
    <NavigationView x:Name="NavView" Grid.Row="1" Background="Transparent" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsPaneOpen="True" IsPaneToggleButtonVisible="True" IsSettingsVisible="False" OpenPaneLength="224" PaneDisplayMode="Left" SelectionChanged="NavView_SelectionChanged" SelectionFollowsFocus="Disabled">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="常规" Tag="general">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Home" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="外观" Tag="appearance">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Highlight" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="行为" Tag="behavior">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="AllApps" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="动画" Tag="animation">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Play" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="诊断与维护" Tag="diagnostics">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Repair" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="关于" Tag="about">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Help" Foreground="{ThemeResource SystemFillColorNeutralBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.Content>
        <ScrollViewer x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PageHost" MaxWidth="920" Padding="24,10,24,36" HorizontalAlignment="Center" Spacing="8">
            <StackPanel.RenderTransform>
              <TranslateTransform x:Name="PageTransform" />
            </StackPanel.RenderTransform>
            <Grid Margin="4,0,4,10">
              <StackPanel Spacing="2">
                <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" Text="常规" />
                <TextBlock x:Name="PageSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="连接、主题与配置文件。" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <!-- General -->
            <StackPanel x:Name="GeneralPage" Spacing="0">
              <controls:SettingsCard Title="主题" Description="跟随 Windows，或固定为深色 / 浅色。" IconSymbol="Highlight">
                <controls:SettingsCard.CardContent>
                  <ComboBox x:Name="ThemeCombo" Width="200" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="跟随系统" Tag="system" />
                    <ComboBoxItem Content="浅色" Tag="light" />
                    <ComboBoxItem Content="深色" Tag="dark" />
                  </ComboBox>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="强调色" Description="影响运行圆点、拖拽指示条与选中态。" IconSymbol="FontColor">
                <controls:SettingsCard.CardContent>
                  <StackPanel x:Name="AccentPanel" Orientation="Horizontal" Spacing="8" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard x:Name="ConfigCard" Title="配置文件" Description="…" IconSymbol="Folder">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开文件夹" Click="OpenConfig_Click" />
                    <Button Content="重新加载" Click="Reload_Click" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="恢复默认设置" Description="把外观、行为与动效恢复为首次启动状态，条目不会删除。" IconSymbol="Refresh">
                <controls:SettingsCard.CardContent>
                  <Button Content="恢复默认" Click="Reset_Click" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="Dock 层级" Description="桌面同级位于普通窗口下方；动态层级在交互时置顶；置顶始终最上。" IconSymbol="ViewAll">
                <controls:SettingsCard.CardContent>
                  <ComboBox x:Name="LayerCombo" Width="220" SelectionChanged="LayerCombo_SelectionChanged">
                    <ComboBoxItem Content="桌面同级" Tag="desktop" />
                    <ComboBoxItem Content="动态层级" Tag="dynamic" />
                    <ComboBoxItem Content="置顶" Tag="topmost" />
                  </ComboBox>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard x:Name="StartupCard" Title="开机自启动" Description="登录 Windows 时自动启动 Dock。" IconSymbol="Play" IsExpandable="True">
                <controls:SettingsCard.CardContent>
                  <ToggleSwitch x:Name="StartupToggle" MinWidth="0" Toggled="StartupToggle_Toggled" />
                </controls:SettingsCard.CardContent>
                <controls:SettingsCard.ExpanderContent>
                  <StackPanel Spacing="8">
                    <TextBlock Text="选择启动方式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <RadioButtons x:Name="StartupModeChoices" SelectionChanged="StartupModeChoices_SelectionChanged">
                      <x:String>快速：计划任务（推荐，需管理员）</x:String>
                      <x:String>兼容：注册表 Run（无需管理员，可能延迟）</x:String>
                    </RadioButtons>
                    <TextBlock x:Name="StartupHintText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SettingsCard.ExpanderContent>
              </controls:SettingsCard>
            </StackPanel>
            <!-- Appearance -->
            <StackPanel x:Name="AppearancePage" Spacing="0" Visibility="Collapsed">
              <controls:SettingsCard Title="图标大小" Description="单个图标的边长，单位为 DIP。" IconSymbol="FontSize">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="IconSizeSlider" Width="220" Minimum="24" Maximum="96" StepFrequency="1" Tag="icon_size" ValueChanged="Slider_ValueChanged" />
                    <TextBlock x:Name="IconSizeValue" Width="56" Text="{Binding Value, ElementName=IconSizeSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=px}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="图标间距" Description="相邻图标的空隙，影响 Dock 的总宽度。" IconSymbol="Orientation">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="SpacingSlider" Width="220" Minimum="0" Maximum="24" StepFrequency="1" Tag="spacing" ValueChanged="Slider_ValueChanged" />
                    <TextBlock x:Name="SpacingValue" Width="56" Text="{Binding Value, ElementName=SpacingSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=px}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="内边距" Description="图标与玻璃背景边缘之间的距离。" IconSymbol="FullScreen">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="PaddingSlider" Width="220" Minimum="6" Maximum="28" StepFrequency="1" Tag="padding" ValueChanged="Slider_ValueChanged" />
                    <TextBlock x:Name="PaddingValue" Width="56" Text="{Binding Value, ElementName=PaddingSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=px}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="圆角" Description="Dock 玻璃背景的圆角半径。" IconSymbol="Edit">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="CornerRadiusSlider" Width="220" Minimum="8" Maximum="36" StepFrequency="1" Tag="corner_radius" ValueChanged="Slider_ValueChanged" />
                    <TextBlock x:Name="CornerRadiusValue" Width="56" Text="{Binding Value, ElementName=CornerRadiusSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=px}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="背景不透明度" Description="越高越不透，越低越能看到壁纸。" IconSymbol="View">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="OpacitySlider" Width="220" Minimum="40" Maximum="100" StepFrequency="1" Tag="opacity" ValueChanged="Slider_ValueChanged" />
                    <TextBlock x:Name="OpacityValue" Width="56" Text="{Binding Value, ElementName=OpacitySlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=percent}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="离屏幕底边距离" Description="Dock 窗口与工作区底边的距离。" IconSymbol="DockBottom">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="EdgeMarginSlider" Width="220" Minimum="0" Maximum="40" StepFrequency="1" Tag="edge_margin" ValueChanged="Slider_ValueChanged" />
                    <TextBlock x:Name="EdgeMarginValue" Width="64" Text="{Binding Value, ElementName=EdgeMarginSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=px}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="水平偏移" Description="相对于屏幕居中的左右微调。" IconSymbol="Switch">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="OffsetSlider" Width="220" Minimum="-300" Maximum="300" StepFrequency="1" Tag="offset" ValueChanged="Slider_ValueChanged" />
                    <TextBlock x:Name="OffsetValue" Width="64" Text="{Binding Value, ElementName=OffsetSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=px_signed}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
            </StackPanel>
            <!-- Behavior -->
            <StackPanel x:Name="BehaviorPage" Spacing="0" Visibility="Collapsed">
              <controls:SettingsCard Title="悬停动效" Description="开启或关闭悬停层动画（放大、跳跃、光晕、倾斜等）。" IconSymbol="Zoom">
                <controls:SettingsCard.CardContent>
                  <ToggleSwitch x:Name="MagnificationToggle" MinWidth="0" Tag="magnification" Toggled="Toggle_Toggled" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="名称提示" Description="悬停片刻后在上方显示应用名称。" IconSymbol="Comment">
                <controls:SettingsCard.CardContent>
                  <ToggleSwitch x:Name="TooltipsToggle" MinWidth="0" Tag="tooltips" Toggled="Toggle_Toggled" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="启动动画" Description="点击启动后播放所选的启动动画。" IconSymbol="Play">
                <controls:SettingsCard.CardContent>
                  <ToggleSwitch x:Name="LaunchAnimationToggle" MinWidth="0" Tag="launch_animation" Toggled="Toggle_Toggled" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="运行状态圆点" Description="在运行中的应用下方显示一个小圆点。" IconSymbol="Clock">
                <controls:SettingsCard.CardContent>
                  <ToggleSwitch x:Name="RunningIndicatorToggle" MinWidth="0" Tag="running_indicator" Toggled="Toggle_Toggled" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
            </StackPanel>
            <!-- Animation -->
            <StackPanel x:Name="AnimationPage" Spacing="0" Visibility="Collapsed">
              <controls:SettingsCard Title="启用动画" Description="关闭后所有图标动效立即停止，等待点与运行点保持静态。" IconSymbol="Sync">
                <controls:SettingsCard.CardContent>
                  <ToggleSwitch x:Name="MotionEnabledToggle" MinWidth="0" Tag="motion_enabled" Toggled="MotionToggle_Toggled" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="跟随系统减少动态效果" Description="Windows 关闭动画效果时，Dock 不播放悬停与启动时间轴。" IconSymbol="Help">
                <controls:SettingsCard.CardContent>
                  <ToggleSwitch x:Name="ReducedMotionToggle" MinWidth="0" Tag="respect_reduced" Toggled="MotionToggle_Toggled" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="悬停动画" Description="Glide Zoom 为全 Dock 连续放大；其余为独立指针交互语言。" IconSymbol="Zoom">
                <controls:SettingsCard.CardContent>
                  <ComboBox x:Name="HoverPresetCombo" Width="260" SelectionChanged="HoverPresetCombo_SelectionChanged">
                    <ComboBoxItem Content="Glide Zoom · 苹果式放大" Tag="glide_zoom" />
                    <ComboBoxItem Content="Bounce · 弹性跳跃" Tag="bounce" />
                    <ComboBoxItem Content="Wave · 波浪联动" Tag="wave" />
                    <ComboBoxItem Content="Fluid Press · 流体按压" Tag="fluid_press" />
                    <ComboBoxItem Content="Glow · 光效呼吸" Tag="glow" />
                    <ComboBoxItem Content="Perspective · 3D 灵动" Tag="perspective" />
                  </ComboBox>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="应用启动动画" Description="点击图标后播放的启动反馈。" IconSymbol="Play">
                <controls:SettingsCard.CardContent>
                  <ComboBox x:Name="LaunchPresetCombo" Width="260" SelectionChanged="LaunchPresetCombo_SelectionChanged">
                    <ComboBoxItem Content="Glide Launch · 快速放大上浮" Tag="glide_launch" />
                    <ComboBoxItem Content="Triple Bounce · 三次递减弹跳" Tag="triple_bounce" />
                    <ComboBoxItem Content="Ripple Launch · 光环扩散" Tag="ripple_launch" />
                    <ComboBoxItem Content="Pulse Launch · 脉冲光晕" Tag="pulse_launch" />
                  </ComboBox>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="最大放大倍率" Description="悬停放大峰值；Bounce 也会用它计算跳跃高度。" IconSymbol="ZoomIn">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="MaxScaleSlider" Width="220" Minimum="1.05" Maximum="3.50" StepFrequency="0.05" Tag="max_scale" ValueChanged="MotionSlider_ValueChanged" />
                    <TextBlock x:Name="MaxScaleValue" Width="64" Text="{Binding Value, ElementName=MaxScaleSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=scale}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="动画时长" Description="其他悬停预设的基准时长；Glide Zoom 固定 35ms 进入 / 50ms 退出。" IconSymbol="Clock">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="HoverMsSlider" Width="220" Minimum="80" Maximum="400" StepFrequency="5" Tag="hover_ms" ValueChanged="MotionSlider_ValueChanged" />
                    <TextBlock x:Name="HoverMsValue" Width="64" Text="{Binding Value, ElementName=HoverMsSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=ms}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="弹性强度" Description="越高越有弹性；0% 完全平稳。" IconSymbol="Target">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="ElasticitySlider" Width="220" Minimum="0" Maximum="100" StepFrequency="1" Tag="elasticity" ValueChanged="MotionSlider_ValueChanged" />
                    <TextBlock x:Name="ElasticityValue" Width="64" Text="{Binding Value, ElementName=ElasticitySlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=percent}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="影响范围" Description="悬停放大向两侧扩散的槽位数。" IconSymbol="ZoomOut">
                <controls:SettingsCard.CardContent>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Slider x:Name="RangeSlider" Width="220" Minimum="0.5" Maximum="8.0" StepFrequency="0.1" Tag="range_slots" ValueChanged="MotionSlider_ValueChanged" />
                    <TextBlock x:Name="RangeValue" Width="64" Text="{Binding Value, ElementName=RangeSlider, Converter={StaticResource ValueLabelConverter}, ConverterParameter=one_decimal}" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="推荐搭配" Description="只作提示，不强制替换你的选择。" IconSymbol="Comment">
                <controls:SettingsCard.CardContent>
                  <TextBlock x:Name="RecommendationText" Text="建议搭配：Glide Launch" Width="260" TextWrapping="Wrap" VerticalAlignment="Center" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="动画配置" Description="把当前的动效预设与参数复制为 JSON，便于备份或分享。" IconSymbol="Edit">
                <controls:SettingsCard.CardContent>
                  <Button Content="复制动画配置" Click="CopyMotion_Click" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
            </StackPanel>
            <!-- Diagnostics -->
            <StackPanel x:Name="DiagnosticsPage" Spacing="0" Visibility="Collapsed">
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,6" MaxWidth="840" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                    <SymbolIcon Symbol="Repair" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="拖拽诊断" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="检查 Dock、设置中心、Explorer 的权限与启动状态，定位拖不进 Dock 的原因。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DiagnosticsSummary" FontSize="14" FontWeight="SemiBold" Text="尚未检测" TextWrapping="Wrap" />
                    <TextBlock x:Name="DiagnosticsHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="DiagnosticsRows" Spacing="4" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                      <Button Content="刷新" Click="RefreshDiagnostics_Click" />
                      <Button Content="复制诊断" Click="CopyDiagnostics_Click" />
                      <Button Content="修复" IsEnabled="False" ToolTipService.ToolTip="当前版本仅提供诊断，请按提示手动处理" />
                      <Button Content="打开日志目录" Click="OpenLogs_Click" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,6" MaxWidth="840" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                    <SymbolIcon Symbol="Help" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="诊断说明" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="诊断只读取本机状态，不会修改配置、权限或启动项。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="管理员权限会触发 Windows UIPI，普通 Explorer 无法把文件拖入管理员进程；Low Integrity 也会限制拖放和子应用启动。推荐以普通用户从开始菜单或桌面快捷方式启动 Dock。" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
            <!-- About -->
            <StackPanel x:Name="AboutPage" Spacing="0" Visibility="Collapsed">
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,6">
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="64" Height="64" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="14">
                    <FontIcon Glyph="&#xE7F4;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Glide-Dock" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="更轻、更快、更贴近 Windows 11 的桌面 Dock。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" Text="v0.1.0" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                      <Button Content="打开配置文件夹" Click="OpenConfig_Click" />
                      <Button Content="诊断与维护" Click="OpenDiagnostics_Click" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <controls:SettingsCard Title="许可证" Description="Glide-Dock 源代码：MIT OR Apache-2.0。" IconSymbol="Help">
                <controls:SettingsCard.CardContent>
                  <TextBlock Text="MIT / Apache-2.0" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
              <controls:SettingsCard Title="配置文件" Description="当前设置进程读取的 JSON 配置。" IconSymbol="Folder">
                <controls:SettingsCard.CardContent>
                  <TextBlock x:Name="AboutConfigPath" MaxWidth="520" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard.CardContent>
              </controls:SettingsCard>
            </StackPanel>
            <!-- Search -->
            <StackPanel x:Name="SearchPage" Spacing="12" Visibility="Collapsed">
              <TextBlock x:Name="SearchSummary" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <StackPanel x:Name="SearchResultsPanel" Spacing="6" />
              <StackPanel x:Name="SearchEmptyPanel" Margin="0,36,0,0" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SearchEmptyText" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="没有匹配的设置项" />
                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="试试“主题”“动画”或“启动”" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </NavigationView.Content>
    </NavigationView>
  </Grid>
</Window>