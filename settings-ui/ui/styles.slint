export global SettingsStyle {
    in-out property <bool> dark: false;
    out property <color> canvas: dark ? #181c20 : #f5f7f9;
    out property <color> sidebar: dark ? #20252a : #edf1f5;
    out property <color> surface: dark ? #252b31 : #ffffff;
    out property <color> line: dark ? #373e46 : #dfe5eb;
    out property <color> text: dark ? #edf2f7 : #202c38;
    out property <color> muted: dark ? #aab6c2 : #647586;
}
