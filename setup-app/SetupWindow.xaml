<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlideDock.Setup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glide-Dock 安装程序">
    <Grid x:Name="RootGrid" Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#EEF2F5" BorderBrush="#DDE3E8" BorderThickness="0,0,1,0">
            <Grid Padding="26,30,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="10">
                    <Image x:Name="BrandLogo" Height="42" HorizontalAlignment="Left" Stretch="Uniform" />
                    <TextBlock Text="安装向导" FontSize="14" Foreground="#56616A" />
                </StackPanel>
                <StackPanel x:Name="StepList" Grid.Row="1" Spacing="10" Margin="0,44,0,0" />
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="Glide-Dock" FontSize="13" FontWeight="SemiBold" Foreground="#26323B" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#78838C" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PageHost" Padding="46,40,46,24" Spacing="16" />
            </ScrollViewer>
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E5E8" BorderThickness="0,1,0,0" Padding="28,16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12" Foreground="#77828B" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CancelButton" Content="取消" MinWidth="92" Click="Cancel_Click" />
                        <Button x:Name="BackButton" Content="上一步" MinWidth="92" Click="Back_Click" />
                        <Button x:Name="NextButton" Content="继续" MinWidth="124" Click="Next_Click"
                                Background="#0866C6" Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
